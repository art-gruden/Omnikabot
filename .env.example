# Обов'язково: токен від @BotFather
BOT_TOKEN=

# Часовий пояс: за ним бот визначає сьогоднішню дату для фото ddmm.jpg
TZ=Europe/Berlin

# Необов'язково: ID адміністраторів через кому (свій ID: команда /id у боті).
# Якщо порожньо — адміном стає перший, хто напише боту /start.
ADMIN_IDS=

# Початкові значення для нових користувачів (далі все змінюється в меню бота):
# DEFAULT_TITLE=ЕНЕРГОЗАВАНТАЖЕННЯ
# DEFAULT_SIZE=1280x782
# DEFAULT_TEMPLATE=pink_glow

# Хто малює зображення: gemini або openai.
# Якщо рядок IMAGE_PROVIDER прибрати: gemini, коли заданий GEMINI_API_KEY, інакше openai.
IMAGE_PROVIDER=gemini
# Ключ Gemini: aistudio.google.com → Get API key
GEMINI_API_KEY=
# nano-banana-2-1k = Nano Banana 2 (gemini-3.1-flash-image), розмір 1K. Суфікс -1k / -2k / -4k задає розмір.
# Інші назви: nano-banana-2.1-1k, nano-banana-2-lite-1k, nano-banana-pro-2k або справжній ID моделі Gemini.
GEMINI_MODEL=nano-banana-2-1k
# GEMINI_TIMEOUT=120             # тайм-аут однієї спроби, секунд
# IMAGE_ATTEMPTS=3               # скільки спроб робить Gemini-провайдер, перш ніж узяти запасну картинку
# IMAGE_RETRY_DELAY=2            # пауза між спробами, секунд (множиться на номер спроби)
# GEMINI_API=generateContent     # або interactions — новіший інтерфейс Gemini API
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GENERATED_DIR=/data/generated  # куди зберігаються згенеровані зображення
# GENERATED_IMAGES_KEEP=200      # скільки останніх файлів тримати
# IMAGE_BACKUP_DIR=/data/backup-images   # запасні картинки для постів, якщо немає фото дня ddmm.jpg

# ChatGPT (OpenAI): оформлення текстів і тема картинки; зображення — лише коли IMAGE_PROVIDER=openai.
# Ключ можна ввести й у меню бота: 🛠 Адміністрування → 🤖 OpenAI.
# OPENAI_API_KEY=
# OPENAI_TEXT_MODEL=gpt-5.4-mini
# OPENAI_IMAGE_MODEL=gpt-image-1.5
# OPENAI_BASE_URL=https://api.openai.com/v1
# IMAGE_LIMIT_PER_DAY=20

# Готові промти картинок і кнопка «Відкрити в ChatGPT»
# IMAGE_PROMPTS_DIR=/app/prompts
# CHATGPT_URL=https://chatgpt.com/
# MAX_BUTTON_URL=4096      # найдовше посилання, яке бот пробує покласти в кнопку
# SAFE_BUTTON_URL=2048     # до цієї довжини посилання скорочується, якщо Telegram відхилив повне

# Папка з фото на кожен день для рубрики «Єдність сердець» (файли ddmm.jpg: 1611.jpg)
# PHOTOS_DIR=/data/photos

# Ліміти
# MAX_WORDS=40
# MAX_CHARS=400
# MAX_UPLOAD_MB=20
# RENDER_CONCURRENCY=2
# LOG_LEVEL=INFO

# Власний сервер Bot API (зазвичай не потрібно)
# TELEGRAM_API_URL=http://telegram-bot-api:8081/bot
# TELEGRAM_FILE_URL=http://telegram-bot-api:8081/file/bot
